#!/usr/bin/env bash
# factory — run the software-factory agent harness in an Apple `container` micro-VM.
#
#   factory doctor                    check everything the harness needs
#   factory build [--no-cache]       (re)build the agent image
#   factory run <spec> [options]      run the generate->evaluate loop on a spec
#   factory probe                     verify container -> Supabase connectivity
#   factory shell                     interactive debug shell inside the agent image
#   factory runs                      list past runs and their status
#   factory logs [run-id]             show a run's verdict and trace locations
#   factory clean [-f]                delete past runs
#
# See harness/README.md for details.
set -euo pipefail

HARNESS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT_DIR="$(cd "$HARNESS_DIR/.." && pwd)"
RUNS_DIR="$HARNESS_DIR/runs"
IMAGE="${FACTORY_IMAGE:-factory-agent:latest}"
DNS_BRIDGE="host.container.internal"

# ── helpers ───────────────────────────────────────────────────────────────────

info() { printf '==> %s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }

require_container() {
  command -v container >/dev/null 2>&1 \
    || die "the Apple 'container' CLI is not installed (https://github.com/apple/container)"
  container system status >/dev/null 2>&1 \
    || die "container system is not running — start it with: container system start"
}

have_image() { container image list 2>/dev/null | awk '{print $1":"$2}' | grep -qx "$IMAGE"; }

ensure_image() {
  have_image && return
  info "image $IMAGE not found; building it"
  cmd_build
}

# Auth for the claude binary inside the container: prefer a subscription OAuth
# token (from `claude setup-token`), else fall back to an API key.
auth_env() {
  if   [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then printf 'CLAUDE_CODE_OAUTH_TOKEN'
  elif [ -n "${ANTHROPIC_API_KEY:-}" ];      then printf 'ANTHROPIC_API_KEY'
  else return 1; fi
}

# Load Supabase URL/key from the app's dotenv. Containers can't see the host's
# localhost, so local URLs are rewritten to the DNS bridge.
load_supabase_env() {
  local f env_file=""
  for f in "$ROOT_DIR/.env.local" "$ROOT_DIR/.env"; do
    [ -f "$f" ] && env_file="$f" && break
  done
  [ -n "$env_file" ] || die "no .env.local/.env in $ROOT_DIR — run 'npx supabase start' and fill it in"
  set -a; . "$env_file"; set +a
  SUPABASE_URL="${NEXT_PUBLIC_SUPABASE_URL:?missing NEXT_PUBLIC_SUPABASE_URL in $env_file}"
  SUPABASE_KEY="${NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:?missing NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY in $env_file}"
  case "$SUPABASE_URL" in
    *localhost*|*127.0.0.1*)
      SUPABASE_URL="$(printf '%s' "$SUPABASE_URL" | sed -E "s#(localhost|127\\.0\\.0\\.1)#$DNS_BRIDGE#")"
      info "local Supabase URL detected; containers will use $SUPABASE_URL"
      ;;
  esac
  export SUPABASE_URL SUPABASE_KEY
}

latest_run() { ls -1t "$RUNS_DIR" 2>/dev/null | head -1; }

write_run_meta() { # $1=run dir  $2=status  $3=exit code
  cat > "$1/run.json" <<EOF
{
  "spec": "$SPEC_NAME",
  "model": "$MODEL",
  "max_passes": $MAX_PASSES,
  "started": "$STARTED",
  "status": "$2",
  "exit_code": $3
}
EOF
}

# ── commands ──────────────────────────────────────────────────────────────────

cmd_doctor() {
  local ok=1
  check() { # $1=hard(1)/soft(0)  $2=label  $3=fix  $4...=command
    local hard="$1" label="$2" fix="$3"; shift 3
    if "$@" >/dev/null 2>&1; then
      printf '  ✓ %s\n' "$label"
    else
      local mark='-'
      [ "$hard" = 1 ] && { mark='✗'; ok=0; }
      printf '  %s %-32s fix: %s\n' "$mark" "$label" "$fix"
    fi
  }
  echo "hard requirements:"
  check 1 "container CLI installed" "install from https://github.com/apple/container" \
    command -v container
  check 1 "container system running" "container system start" \
    container system status
  check 1 "agent auth env" "export CLAUDE_CODE_OAUTH_TOKEN (from 'claude setup-token') or ANTHROPIC_API_KEY" \
    auth_env
  echo
  echo "for runs (soft — first run fixes or degrades gracefully):"
  check 0 "agent image built ($IMAGE)" "factory build" \
    have_image
  check 0 "DNS bridge '$DNS_BRIDGE'" "sudo container system dns create $DNS_BRIDGE --localhost 203.0.113.113" \
    sh -c "container system dns list | grep -q '$DNS_BRIDGE'"
  check 0 "Supabase reachable on host" "npx supabase start" \
    curl -fsS --max-time 3 http://127.0.0.1:54321/auth/v1/health
  check 0 "Supabase env in .env(.local)" "npx supabase start, then copy URL + publishable key into .env" \
    sh -c "grep -qs '^NEXT_PUBLIC_SUPABASE_URL=' '$ROOT_DIR/.env' '$ROOT_DIR/.env.local'"
  echo
  [ "$ok" = 1 ] && info "ready" || die "fix the ✗ items above"
}

cmd_build() {
  require_container
  # The BuildKit builder VM needs a working nameserver to fetch apt packages and
  # the claude installer; --dns is a no-op when yours already works. If a build
  # still can't resolve hosts:  container builder stop && container builder start --dns 8.8.8.8
  info "building $IMAGE"
  container build --dns "${CONTAINER_DNS:-8.8.8.8}" "$@" \
    --tag "$IMAGE" --file "$HARNESS_DIR/image/Dockerfile" "$HARNESS_DIR/image"
}

cmd_run() {
  local spec="" name="" with_supabase=0
  MODEL="${MODEL:-sonnet}" MAX_PASSES="${MAX_PASSES:-3}" PASS_TIMEOUT="${PASS_TIMEOUT:-1800}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --model)      MODEL="$2"; shift 2 ;;
      --max-passes) MAX_PASSES="$2"; shift 2 ;;
      --timeout)    PASS_TIMEOUT="$2"; shift 2 ;;
      --name)       name="$2"; shift 2 ;;
      --supabase)   with_supabase=1; shift ;;
      -*)           die "unknown option for run: $1" ;;
      *)            [ -z "$spec" ] || die "only one spec per run"; spec="$1"; shift ;;
    esac
  done
  [ -n "$spec" ] || die "usage: factory run <spec.md> [--model m] [--max-passes n] [--timeout s] [--name id] [--supabase]"
  # Accept a path or the name of a bundled spec (harness/specs/<name>.md).
  if [ ! -f "$spec" ]; then
    [ -f "$HARNESS_DIR/specs/$spec" ] && spec="$HARNESS_DIR/specs/$spec"
    [ -f "$HARNESS_DIR/specs/$spec.md" ] && spec="$HARNESS_DIR/specs/$spec.md"
  fi
  [ -f "$spec" ] || die "spec not found: $spec"

  require_container
  auth_env >/dev/null || die "set CLAUDE_CODE_OAUTH_TOKEN (from \`claude setup-token\`) or ANTHROPIC_API_KEY"
  ensure_image

  local supabase_args=()
  if [ "$with_supabase" = 1 ]; then
    load_supabase_env
    supabase_args=(--env SUPABASE_URL --env SUPABASE_KEY)
  fi

  SPEC_NAME="$(basename "$spec")"
  STARTED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local run_id="${name:-$(date -u +%Y%m%d-%H%M%S)-${SPEC_NAME%.md}}"
  local run_dir="$RUNS_DIR/$run_id"
  [ -e "$run_dir" ] && die "run '$run_id' already exists"
  mkdir -p "$run_dir/workspace" "$run_dir/logs"
  cp "$spec" "$run_dir/spec.md"
  write_run_meta "$run_dir" running -1

  info "run $run_id  (model=$MODEL, max_passes=$MAX_PASSES, spec=$SPEC_NAME)"
  local rc=0
  container run --rm \
    --mount "type=bind,source=$run_dir,target=/job" \
    --mount "type=bind,source=$HARNESS_DIR/container,target=/harness/bin,readonly" \
    --mount "type=bind,source=$HARNESS_DIR/prompts,target=/harness/prompts,readonly" \
    --env "$(auth_env)" \
    --env MODEL="$MODEL" --env MAX_PASSES="$MAX_PASSES" --env PASS_TIMEOUT="$PASS_TIMEOUT" \
    --env RUN_DIR=/job --env PROMPTS=/harness/prompts \
    --env IS_SANDBOX=1 \
    "${supabase_args[@]+"${supabase_args[@]}"}" \
    "$IMAGE" bash /harness/bin/loop.sh || rc=$?

  case $rc in
    0) write_run_meta "$run_dir" pass 0;   info "PASS — artifacts in $run_dir/workspace" ;;
    2) write_run_meta "$run_dir" fail 2;   warn "no PASS within $MAX_PASSES passes — verdict: $run_dir/eval.txt" ;;
    *) write_run_meta "$run_dir" error $rc; warn "run errored (exit $rc) — traces: $run_dir/logs/" ;;
  esac
  return $rc
}

cmd_probe() {
  require_container; ensure_image; load_supabase_env
  container run --rm \
    --mount "type=bind,source=$HARNESS_DIR/container,target=/harness/bin,readonly" \
    --env SUPABASE_URL --env SUPABASE_KEY \
    "$IMAGE" bash /harness/bin/probe.sh
}

cmd_shell() {
  require_container; ensure_image
  local extra=()
  ! auth_env >/dev/null || extra+=(--env "$(auth_env)")
  # Pass Supabase env through when the dotenv is usable; skip silently otherwise.
  if (load_supabase_env) >/dev/null 2>&1; then
    load_supabase_env >/dev/null
    extra+=(--env SUPABASE_URL --env SUPABASE_KEY)
  fi
  info "debug shell in $IMAGE (harness scripts at /harness)"
  exec container run -it --rm \
    --mount "type=bind,source=$HARNESS_DIR/container,target=/harness/bin,readonly" \
    --mount "type=bind,source=$HARNESS_DIR/prompts,target=/harness/prompts,readonly" \
    "${extra[@]+"${extra[@]}"}" \
    "$IMAGE" bash
}

cmd_runs() {
  [ -n "$(latest_run)" ] || { echo "no runs yet"; return; }
  printf '%-40s %s\n' RUN STATUS
  local d
  for d in $(ls -1t "$RUNS_DIR"); do
    printf '%-40s %s\n' "$d" \
      "$(sed -n 's/.*"status": *"\([^"]*\)".*/\1/p' "$RUNS_DIR/$d/run.json" 2>/dev/null || echo '?')"
  done
}

cmd_logs() {
  local run="${1:-$(latest_run)}"
  [ -n "$run" ] || die "no runs yet"
  local dir="$RUNS_DIR/$run"
  [ -d "$dir" ] || die "no such run: $run (see: factory runs)"
  info "run: $run"
  [ -f "$dir/run.json" ] && cat "$dir/run.json"
  if [ -f "$dir/eval.txt" ]; then echo; info "latest verdict (eval.txt):"; cat "$dir/eval.txt"; fi
  echo; info "artifacts: $dir/workspace"
  info "full agentic traces:"; ls -1 "$dir/logs" 2>/dev/null | sed "s#^#  $dir/logs/#" || echo "  (none)"
}

cmd_clean() {
  [ -n "$(latest_run)" ] || { echo "nothing to clean"; return; }
  if [ "${1:-}" != "-f" ] && [ "${1:-}" != "--force" ]; then
    printf 'delete all runs under %s? [y/N] ' "$RUNS_DIR"
    read -r reply; case "$reply" in y|Y) ;; *) echo "aborted"; return 1 ;; esac
  fi
  rm -rf "${RUNS_DIR:?}"/*
  info "runs deleted"
}

usage() { sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  doctor) shift; cmd_doctor "$@" ;;
  build)  shift; cmd_build "$@" ;;
  run)    shift; cmd_run "$@" ;;
  probe)  shift; cmd_probe "$@" ;;
  shell)  shift; cmd_shell "$@" ;;
  runs)   shift; cmd_runs "$@" ;;
  logs)   shift; cmd_logs "$@" ;;
  clean)  shift; cmd_clean "$@" ;;
  -h|--help|help|"") usage ;;
  *) die "unknown command: $1 (try: factory --help)" ;;
esac
